import numpy as np
import matplotlib.pyplot as plt

# --- 1. Define XOR Data ---
# Inputs: (x1, x2)
X = np.array([[0, 0],
              [0, 1],
              [1, 0],
              [1, 1]])
# Targets: (y) - XOR output
Y = np.array([[0],
              [1],
              [1],
              [0]])

# --- 2. Initial Parameters ---
eta = 3  # Learning Rate
epochs = 350

# Initialize weights and biases as specified
# Weights for Hidden Layer (2x2 matrix: (w1, w2) and (w3, w4))
W_h = np.array([[3.0, 1.0],
                [1.0, 1.0]])
# Bias for Hidden Layer (1x2 vector: (b1, b2))
B_h = np.array([[-2.0, 1.0]])

# Weights for Output Layer (2x1 matrix: (w5) and (w6))
W_o = np.array([[1.0],
                [1.0]])
# Bias for Output Layer (1x1 vector: (b3))
B_o = np.array([[2.0]])


# --- 3. Define Activation Function and its Derivative ---
def sigmoid(z):
    """Sigmoid activation function"""
    return 1 / (1 + np.exp(-z))

def sigmoid_derivative(a):
    """Derivative of sigmoid function"""
    return a * (1 - a)

# --- 4. Training Loop (Batch Learning) ---
error_history = []

for epoch in range(epochs):
    # --- A. FORWARD PASS ---
    
    # Hidden Layer (z3, z4)
    # Z_h shape: (4, 2) - 4 samples, 2 hidden neurons
    # Z_h = X @ W_h + B_h (broadcasting B_h)
    Z_h = np.dot(X, W_h) + B_h
    print(f"Final Weights Z_h:\n{Z_h}")
    # Hidden Activation (a3, a4)
    A_h = sigmoid(Z_h)  # A_h shape: (4, 2)
    print(f"Final Weights A_h:\n{A_h}")
    # Output Layer (z5)
    # Z_o shape: (4, 1) - 4 samples, 1 output neuron
    # Z_o = A_h @ W_o + B_o (broadcasting B_o)
    Z_o = np.dot(A_h, W_o) + B_o
    print(f"Final Weights A_h:\n{Z_o}")
    # Output Activation (a5)
    A_o = sigmoid(Z_o)  # A_o shape: (4, 1)
    print(f"Final Weights A_o:\n{A_o}")
    # --- B. BATCH ERROR CALCULATION ---
    # Mean Squared Error (MSE) - Cost Function E = 1/2 * sum((Y - A_o)^2)
    # Note: Using half the sum of squared errors for gradient calculation
    E = 0.5 * np.sum((Y - A_o) ** 2)
    error_history.append(E)
    print(f"Final Weights E :\n{E}")
    # --- C. BACKPROPAGATION (BATCH GRADIENT CALCULATION) ---

    # 1. Output Layer Gradient (Delta_o)
    # Error term (delta_5)
    # dE/dz_5 = (a_5 - y) * a_5 * (1 - a_5)
    Delta_o = (A_o - Y) * sigmoid_derivative(A_o) # Delta_o shape: (4, 1)
    print(f"Delta_o :\n{Delta_o}")
    # 2. Hidden Layer Gradient (Delta_h)
    # Error term (delta_3, delta_4)
    # dE/dz_h = (dE/da_o * da_o/dz_o * dz_o/da_h) * da_h/dz_h
    Delta_h = np.dot(Delta_o, W_o.T) * sigmoid_derivative(A_h) # Delta_h shape: (4, 2)
    print(f"Delta_h :\n{Delta_h}")
    # 3. Calculate Weight and Bias Updates (Averages over the batch)
    
    # Gradient for W_o (dE/dW_o)
    # dE/dW_o = A_h.T @ Delta_o (Average over 4 samples)
    Grad_W_o = np.dot(A_h.T, Delta_o) / len(X) # (2, 1) matrix
    print(f"Grad_W_o :\n{Grad_W_o}")
    # Gradient for B_o (dE/dB_o)
    # dE/dB_o = sum(Delta_o) / 4
    Grad_B_o = np.sum(Delta_o, axis=0, keepdims=True) / len(X) # (1, 1) vector
    # Gradient for W_h (dE/dW_h)
    # dE/dW_h = X.T @ Delta_h (Average over 4 samples)
    Grad_W_h = np.dot(X.T, Delta_h) / len(X) # (2, 2) matrix

    # Gradient for B_h (dE/dB_h)
    # dE/dB_h = sum(Delta_h) / 4
    Grad_B_h = np.sum(Delta_h, axis=0, keepdims=True) / len(X) # (1, 2) vector
    
    # --- D. PARAMETER UPDATE (Gradient Descent) ---
    # New Parameter = Old Parameter - eta * Gradient

    W_o -= eta * Grad_W_o
    B_o -= eta * Grad_B_o
    W_h -= eta * Grad_W_h
    B_h -= eta * Grad_B_h

    # Optional: Stop if the error is small enough
    if E < 0.001:
        print(f"Converged at epoch {epoch}")
        break

# --- 5. Final Results and Plotting ---

print("\n--- Training Complete ---")
print(f"Final Weights W_h:\n{W_h}")
print(f"Final Biases B_h:\n{B_h}")
print(f"Final Weights W_o:\n{W_o}")
print(f"Final Biases B_o:\n{B_o}")
print(f"Final Output (a5):\n{A_o.round(4)}")


# Plot the Error
plt.figure(figsize=(10, 6))
plt.plot(error_history)
plt.title('Error Reduction Over Epochs (Batch Learning)')
plt.xlabel('Epoch')
plt.ylabel('Total Error (0.5 * Sum of Squared Errors)')
plt.grid(True)
plt.show()